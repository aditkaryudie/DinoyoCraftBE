# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinoyocraft_db
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://dinoyocraft.com

# Google OAuth 2.0 (Web & Mobile Android)
GOOGLE_CLIENT_ID=your_google_web_client_id_here
GOOGLE_CLIENT_ID_MOBILE=your_google_android_client_id_here

# Email (Nodemailer - Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=

# Pusher Channels (Real-Time Chat)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=

# Encryption (AES-256-CBC, harus 32 karakter)
ENCRYPTION_KEY=dinoyocraft_secret_key_32_chars!

# Firebase Admin SDK Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# ============================================================
# Payment Gateway: Midtrans (SANDBOX / PRODUCTION)
# ============================================================
PAYMENT_GATEWAY=midtrans
MIDTRANS_IS_PRODUCTION=false

# Dashboard Midtrans > Settings > Access Keys
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_NOTIFICATION_URL=

# Batas waktu bayar (menit). 1440 = 24 jam
PAYMENT_EXPIRY_MINUTES=1440

# Metode pembayaran yang diaktifkan
PAYMENT_ENABLED_METHODS=qris,bca_va,bni_va,bri_va,permata_va,mandiri_bill,gopay,shopeepay

# Konfigurasi Biaya Layanan Platform (dibebankan ke pembeli; fee channel Midtrans ditanggung platform)
PAYMENT_SERVICE_FEE_FIXED=1000
PAYMENT_SERVICE_FEE_PERCENT=5.0

# ============================================================
# Wallet Mitra & Background Poller Midtrans
# ============================================================
MIN_WITHDRAWAL=50000
WITHDRAWAL_FEE=0
PAYMENT_POLLER_ENABLED=true
PAYMENT_POLL_INTERVAL_MS=30000
PAYMENT_POLL_MAX_AGE_HOURS=24
