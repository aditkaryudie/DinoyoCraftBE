# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dinoyocraft_db
DB_USERNAME=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://dinoyocraft.com

# Google OAuth 2.0 Multi-Platform
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_ID_ALT=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_MOBILE=

# Email (Nodemailer - Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=

# Pusher Channels (Real-Time Chat)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=

# Encryption (AES-256-CBC, harus 32 karakter)
ENCRYPTION_KEY=dinoyocraft_secret_key_32_chars!

# Firebase Admin SDK Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# ============================================================
# Payment Gateway (SociaBuzz Native)
# ============================================================
SOCIABUZZ_USERNAME=dinoyocraft
DEFAULT_DONOR_EMAIL=customer@dinoyocraft.com
DEFAULT_DONOR_NAME=Pelanggan DinoyoCraft
WEBHOOK_SECRET=dinoyocraft-webhook-secret-2026

# Konfigurasi Biaya Layanan (Agar Hasil Bersih & Menutup Biaya Penarikan)
# PAYMENT_SERVICE_FEE_FIXED: Biaya penanganan flat (cth: 1000 untuk tabungan biaya penarikan bank)
# PAYMENT_SERVICE_FEE_PERCENT: Persentase untuk menutup fee SociaBuzz (cth: 5.0 untuk fee 5% SociaBuzz)
PAYMENT_SERVICE_FEE_FIXED=1000
PAYMENT_SERVICE_FEE_PERCENT=5.0
